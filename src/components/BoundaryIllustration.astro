<figure class="mx-auto max-w-sm rounded-3xl border border-white/10 bg-surface p-6">
  <svg viewBox="0 0 320 432" class="w-full" role="img" aria-labelledby="boundary-title boundary-description">
    <title id="boundary-title">Two boundaries define a centering measurement</title>
    <desc id="boundary-description">Illustrated card with a physical edge and a printed inner rectangle. The left border is three units wide and the right is two, giving 60/40.</desc>
    <rect x="20" y="20" width="280" height="392" rx="10" fill="#e6e9f0" stroke="#00D4AA" stroke-width="3" />
    <rect x="50" y="44" width="230" height="344" fill="#1E2438" stroke="#C9A84C" stroke-width="3" />
    <text x="165" y="184" text-anchor="middle" fill="#ffffff" font-size="17">Printed boundary</text>
    <text x="165" y="214" text-anchor="middle" fill="#C9A84C" font-size="28" font-weight="700">60 / 40</text>
    <text x="165" y="240" text-anchor="middle" fill="#b7bbcd" font-size="12">left / right</text>
    <line x1="20" y1="300" x2="50" y2="300" stroke="#111827" stroke-width="2" />
    <line x1="280" y1="300" x2="300" y2="300" stroke="#111827" stroke-width="2" />
    <text x="35" y="290" text-anchor="middle" fill="#111827" font-size="14">3</text>
    <text x="290" y="290" text-anchor="middle" fill="#111827" font-size="14">2</text>
    <text x="165" y="401" text-anchor="middle" fill="#111827" font-size="13">Physical card edge</text>
  </svg>
  <figcaption class="mt-4 text-sm text-text-secondary leading-relaxed">Illustration, not a scan. Left 3 units + right 2 units gives 60/40. Check top/bottom separately.</figcaption>
</figure>
