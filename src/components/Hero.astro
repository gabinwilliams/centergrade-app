---
import HeroBackground from './HeroBackground.astro';
import TextHighlight from './react/TextHighlight.tsx';
import BoundaryIllustration from './BoundaryIllustration.astro';
import { appStoreLink } from '../lib/appStoreLink';
const downloadURL = appStoreLink('website-home', import.meta.env.PUBLIC_APP_STORE_PROVIDER_TOKEN);
---

<section id="hero" class="relative py-20 md:py-28 overflow-hidden">
  <HeroBackground />

  <div class="relative z-10 mx-auto max-w-7xl px-6 flex flex-col items-center gap-12 md:gap-16">
    <div class="text-center max-w-2xl">
      <h1 class="text-[32px] md:text-[48px] font-bold leading-tight tracking-[-0.02em] mb-5">
        Check Your Card's Centering{" "}
        <TextHighlight client:visible>Before You Submit or Buy</TextHighlight>
      </h1>
      <p class="text-lg leading-relaxed mb-8" style="color: #8B8FA3;">
        Review the physical and printed boundaries, compare both sides, and keep a centering record.
        Centering is one part of card condition; a photo-based ratio cannot establish an overall grade.
      </p>

      <a href={downloadURL} class="inline-block transition-transform hover:scale-105" aria-label="Download on the App Store">
        <svg viewBox="0 0 180 60" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Download on the App Store" class="h-12 w-auto">
          <rect width="180" height="60" rx="10" fill="#000"/>
          <rect x="0.5" y="0.5" width="179" height="59" rx="9.5" stroke="#A6A6A6" stroke-width="1" fill="none"/>
          <g transform="translate(15, 12)">
            <path d="M18.9 10.2c0-3.4 2.8-5.1 2.9-5.1-1.6-2.3-4-2.6-4.9-2.7-2.1-.2-4 1.2-5.1 1.2-1.1 0-2.7-1.2-4.5-1.2C5 2.5 2.8 4 1.5 6.3c-2.5 4.4-.6 10.9 1.8 14.5 1.2 1.7 2.6 3.7 4.5 3.6 1.8-.1 2.5-1.2 4.6-1.2 2.2 0 2.8 1.2 4.7 1.1 1.9 0 3.2-1.8 4.4-3.5 1.4-2 2-3.9 2-4-.1 0-3.8-1.5-3.8-5.8 0-3.6 2.9-5.3 3.1-5.4-1.7-2.5-4.4-2.8-5.3-2.9-.9-.1-1.8.1-2.6.5z" fill="#fff"/>
            <path d="M15.5 1.7c1-1.2 1.6-2.8 1.4-4.5-1.4.1-3 .9-4 2.1-.9 1-1.7 2.7-1.5 4.3 1.5.1 3.1-.8 4.1-1.9z" fill="#fff" transform="translate(0, 2)"/>
          </g>
          <text x="48" y="22" fill="#fff" font-family="-apple-system, 'Helvetica Neue', sans-serif" font-size="9" font-weight="400">Download on the</text>
          <text x="48" y="42" fill="#fff" font-family="-apple-system, 'Helvetica Neue', sans-serif" font-size="20" font-weight="600">App Store</text>
        </svg>
      </a>
    </div>

    <a href="/guides/60-40-centering/" class="text-brand-teal underline underline-offset-4">Learn what 60/40 means</a>
    <BoundaryIllustration />
  </div>
</section>
