---
import FaqAccordion from './react/FaqAccordion.tsx';
import TextHighlight from './react/TextHighlight.tsx';

const faqItems = [
  {
    question: "How accurate is CenterGrade?",
    answer: "CenterGrade uses Apple's Vision framework to detect card borders down to sub-pixel accuracy. The centering ratios you see match what grading companies measure — but remember, physical grading also accounts for factors like print registration that a photo can't capture."
  },
  {
    question: "Is it really free?",
    answer: "Unlimited scans, no account, no paywall for core features. Premium unlocks scan history, batch scanning, and detailed analytics — but measuring your card's centering is always free."
  },
  {
    question: "What types of cards work?",
    answer: "Any standard rectangular trading card — Pokémon, sports cards, Magic: The Gathering, Yu-Gi-Oh, you name it. If it has a visible border, CenterGrade can measure it."
  },
  {
    question: "What if the auto-detection isn't perfect?",
    answer: "Tap any edge and drag it into position. Pinch to zoom for sub-pixel adjustments. The measurement updates live as you fine-tune — no need to rescan."
  },
  {
    question: "Does CenterGrade store my card photos?",
    answer: "No. All processing happens on-device. Your photos never leave your phone. No cloud uploads, no servers, no data collection."
  },
  {
    question: "What iPhone do I need?",
    answer: "Any iPhone running iOS 17 or later. CenterGrade is optimized for the camera and processing power in iPhone 12 and newer, but works on older supported devices too."
  },
];
---

<section id="faq" class="py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-2xl md:text-[32px] font-bold tracking-[-0.02em] text-center mb-12">
      <TextHighlight client:visible>Questions?</TextHighlight> Answers.
    </h2>

    <FaqAccordion client:visible items={faqItems} />
  </div>
</section>
