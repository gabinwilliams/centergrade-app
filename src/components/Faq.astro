---
import FaqAccordion from './react/FaqAccordion.tsx';
import TextHighlight from './react/TextHighlight.tsx';

const faqItems = [
  { question: "Does the app predict my card's overall grade?", answer: "A centering ratio describes the balance between the selected borders. Grading also considers corners, edges, surface and other condition factors. Use centering as a pre-submission check, not a grade guarantee." },
  { question: "How accurate are the measurements?", answer: "Accuracy depends on the photo and the boundaries you select. Real-card error and repeatability have not been established by a published benchmark. Inspect the pins, use a clear image, and avoid treating extra decimal places as proof of accuracy." },
  { question: "Is the app free?", answer: "CenterGrade is free to download, with an optional one-time Pro purchase. Check the in-app offer for the current features included." },
  { question: "Can I measure every card layout?", answer: "Conventional cards with clear physical and printed boundaries are easier to inspect. Full-art, borderless and intentionally asymmetric layouts may not have a meaningful rectangular inner boundary. Do not invent a border to force a ratio." },
  { question: "Where are my card photos processed?", answer: "Card image analysis runs on your device, and saved scans are stored locally. You choose where to send a shared result. Other services, including analytics, ads and market pricing, can contact servers; see the Privacy Policy for details." },
  { question: "What iPhone do I need?", answer: "The app supports iOS 17 or later. Camera detail and photo conditions affect how clearly you can identify the boundaries." },
];
---

<section id="faq" class="py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-2xl md:text-[32px] font-bold tracking-[-0.02em] text-center mb-12">
      <TextHighlight client:visible>Before you scan</TextHighlight>
    </h2>

    <FaqAccordion client:visible items={faqItems} />
  </div>
</section>
